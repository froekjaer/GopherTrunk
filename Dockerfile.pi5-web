FROM node:22-bookworm AS frontend
WORKDIR /src/web
COPY web/ ./
RUN npm ci --no-audit --no-fund
RUN npm run build

FROM golang:1.26-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/web/dist /src/web/dist
ARG VERSION=pi5-dsc-web
ENV CGO_ENABLED=0
RUN go build -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/gophertrunk ./cmd/gophertrunk

FROM debian:bookworm-slim
RUN groupadd -g 999 gopher && \
    useradd -u 999 -g 999 -m gopher
COPY --from=builder /out/gophertrunk /usr/local/bin/gophertrunk
USER gopher
WORKDIR /home/gopher
EXPOSE 8080 50051
ENTRYPOINT ["/usr/local/bin/gophertrunk"]
